# Copia este archivo a .env.local y completa los valores.
# Clave de API de Resend (https://resend.com/api-keys). Solo servidor.
RESEND_API_KEY=
# Correo destino. En el free tier sin dominio verificado debe ser el correo de tu cuenta de Resend.
RESEND_TO=
# Supabase: URL del proyecto y publishable key (públicas por diseño; Dashboard > Settings > API Keys o MCP get_project_url / get_publishable_keys).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
